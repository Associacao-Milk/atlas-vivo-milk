{
  "@context": {
    "milk": "https://associacaomilk.pt/ontology/milk#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "sourceId": {
      "@id": "milk:sourceId",
      "@type": "xsd:string"
    },
    "sha256": {
      "@id": "milk:sha256",
      "@type": "xsd:string"
    },
    "chunkId": {
      "@id": "milk:chunkId",
      "@type": "xsd:string"
    },
    "text": {
      "@id": "milk:text",
      "@type": "xsd:string"
    },
    "visibility": {
      "@id": "milk:visibility",
      "@type": "xsd:string"
    },
    "epistemicState": {
      "@id": "milk:epistemicState",
      "@type": "xsd:string"
    },
    "responsibleEntity": {
      "@id": "milk:responsibleEntity",
      "@type": "xsd:string"
    },
    "municipality": {
      "@id": "milk:municipality",
      "@type": "xsd:string"
    },
    "parish": {
      "@id": "milk:parish",
      "@type": "xsd:string"
    },
    "documentType": {
      "@id": "milk:documentType",
      "@type": "xsd:string"
    },
    "rgpdStatus": {
      "@id": "milk:rgpdStatus",
      "@type": "xsd:string"
    },
    "consentStatus": {
      "@id": "milk:consentStatus",
      "@type": "xsd:string"
    },
    "humanValidated": {
      "@id": "milk:humanValidated",
      "@type": "xsd:boolean"
    },
    "aiRiskLevel": {
      "@id": "milk:aiRiskLevel",
      "@type": "xsd:string"
    },
    "citations": {
      "@id": "milk:hasCitation",
      "@type": "milk:Chunk"
    },
    "Source": "milk:Source",
    "Chunk": "milk:Chunk",
    "Answer": "milk:Answer"
  },
  "@version": "1.0.0"
}