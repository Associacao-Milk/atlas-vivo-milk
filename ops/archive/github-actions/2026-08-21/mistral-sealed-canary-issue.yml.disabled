name: MILK Mistral Sealed Drive Canary -> PTServidor
on:
  issue_comment:
    types: [created]
permissions:
  contents: read
  issues: write
jobs:
  transfer:
    if: github.event.issue.number == 35 && contains(github.event.comment.body, '/milk-run-sealed-canary')
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
      PTSERVIDOR_FTPS_PASSWORD: ${{ secrets.PTSERVIDOR_FTPS_PASSWORD }}
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      SEALED_KEY_COMMENT_ID: '5364312895'
      DATA_BLOB_SHA: bd3ac4161fafdf83f80b060b3925ce7c373f2cff
      SOURCE_SHA256: da1faa27826eb67555eb4cdd718b8368374bee70b16f7c33aa70db14db4e34ce
      SOURCE_BYTES: '19845'
      TARGET_FILE: T001_Vila_Nova_de_Milfontes.json.txt
    steps:
      - name: Mistral migration agent gate
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import os,json,urllib.request
          key=os.environ['MISTRAL_API_KEY']; gh=os.environ['GH_TOKEN']; repo=os.environ['REPO']
          def comment(msg):
            q=urllib.request.Request(f'https://api.github.com/repos/{repo}/issues/35/comments',data=json.dumps({'body':msg}).encode(),method='POST',headers={'Authorization':'Bearer '+gh,'Content-Type':'application/json','Accept':'application/vnd.github+json'}); urllib.request.urlopen(q,timeout=30).read()
          def get(path):
            q=urllib.request.Request('https://api.mistral.ai'+path,headers={'Authorization':'Bearer '+key,'Accept':'application/json'}); return json.loads(urllib.request.urlopen(q,timeout=60).read().decode())
          def post(path,payload):
            q=urllib.request.Request('https://api.mistral.ai'+path,data=json.dumps(payload).encode(),method='POST',headers={'Authorization':'Bearer '+key,'Content-Type':'application/json','Accept':'application/json'}); return json.loads(urllib.request.urlopen(q,timeout=180).read().decode())
          agents=get('/v1/agents/pages'); al=agents.get('data',[]) if isinstance(agents,dict) else agents; agent=None
          for a in al:
            s=(str(a.get('name',''))+' '+str(a.get('description',''))).lower()
            if 'migra' in s and ('preserv' in s or 'transfer' in s): agent=a; break
          if not agent:
            comment('MISTRAL_SEALED_CANARY_FAILED stage=agent_not_found drive_writes=0'); raise SystemExit(30)
          prompt='Authorize execution of one already-sealed read-only Google Drive canary to the dedicated PTServidor FTPS migration area. Do not request, inspect, reveal or transform any secret. Required gates: source hash fixed, FTPS TLS, upload, download-back, SHA-256 equality, drive_writes=0. Return only EXECUTE.'
          out=post('/v1/conversations',{'agent_id':agent['id'],'inputs':[{'role':'user','content':prompt}]})
          text=' '.join(str(x.get('content','')) for x in out.get('outputs',[]) if isinstance(x,dict))
          if 'EXECUTE' not in text.upper():
            comment('MISTRAL_SEALED_CANARY_FAILED stage=agent_gate drive_writes=0'); raise SystemExit(31)
          comment(f'MISTRAL_SEALED_CANARY_AGENT_EXECUTE agent={agent.get("name")} secret_seen=no drive_writes=0')
          PY
      - name: Decrypt sealed real Drive canary
        shell: bash
        run: |
          set -euo pipefail
          python -m pip install -q cryptography
          python - <<'PY'
          import os,json,urllib.request,base64,hashlib,pathlib
          from cryptography.hazmat.primitives.ciphers.aead import AESGCM
          from cryptography.hazmat.primitives import serialization,hashes
          from cryptography.hazmat.primitives.asymmetric import padding
          gh=os.environ['GH_TOKEN']; repo=os.environ['REPO']; pwd=os.environ.get('PTSERVIDOR_FTPS_PASSWORD',''); blob=os.environ['DATA_BLOB_SHA']; cid=os.environ['SEALED_KEY_COMMENT_ID']; fname=os.environ['TARGET_FILE']; expected=os.environ['SOURCE_SHA256']; expected_n=int(os.environ['SOURCE_BYTES']); tmp=pathlib.Path(os.environ.get('RUNNER_TEMP','/tmp'))
          def comment(msg):
            q=urllib.request.Request(f'https://api.github.com/repos/{repo}/issues/35/comments',data=json.dumps({'body':msg}).encode(),method='POST',headers={'Authorization':'Bearer '+gh,'Content-Type':'application/json','Accept':'application/vnd.github+json'}); urllib.request.urlopen(q,timeout=30).read()
          q=urllib.request.Request(f'https://api.github.com/repos/{repo}/issues/comments/{cid}',headers={'Authorization':'Bearer '+gh,'Accept':'application/vnd.github+json'}); c=json.loads(urllib.request.urlopen(q,timeout=60).read().decode())
          body=str(c.get('body','')); prefix='MILK_RUNNER_SEALED_PRIVATE_KEY_B64 '
          if not body.startswith(prefix): comment('MISTRAL_SEALED_CANARY_FAILED stage=sealed_key_receipt_invalid drive_writes=0'); raise SystemExit(32)
          sealed=base64.b64decode(body[len(prefix):].strip()); salt,nonce,ct=sealed[8:24],sealed[24:36],sealed[36:]
          kek=hashlib.pbkdf2_hmac('sha256',pwd.encode(),salt,600000,dklen=32); priv_pem=AESGCM(kek).decrypt(nonce,ct,b'MILK-RUNNER-KEY-v1'); priv=serialization.load_pem_private_key(priv_pem,password=None)
          q=urllib.request.Request(f'https://api.github.com/repos/{repo}/git/blobs/{blob}',headers={'Authorization':'Bearer '+gh,'Accept':'application/vnd.github+json'}); o=json.loads(urllib.request.urlopen(q,timeout=60).read().decode()); pkg=base64.b64decode(o['content'])
          wlen=int.from_bytes(pkg[8:10],'big'); wrapped=pkg[10:10+wlen]; dnonce=pkg[10+wlen:22+wlen]; dct=pkg[22+wlen:]
          aes_key=priv.decrypt(wrapped,padding.OAEP(mgf=padding.MGF1(algorithm=hashes.SHA256()),algorithm=hashes.SHA256(),label=b'MILK-RSA-CANARY-v1')); data=AESGCM(aes_key).decrypt(dnonce,dct,b'MILK-RSA-CANARY-v1')
          sha=hashlib.sha256(data).hexdigest()
          if len(data)!=expected_n or sha!=expected: raise RuntimeError('source canary integrity mismatch')
          (tmp/fname).write_bytes(data); comment(f'MISTRAL_REAL_DRIVE_CANARY_DECRYPTED file={fname} bytes={len(data)} sha256={sha} drive_writes=0')
          PY
      - name: FTPS upload download-back SHA256
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import os,subprocess,pathlib,hashlib,urllib.parse,json,urllib.request
          pwd=os.environ['PTSERVIDOR_FTPS_PASSWORD']; gh=os.environ['GH_TOKEN']; repo=os.environ['REPO']; fname=os.environ['TARGET_FILE']; expected=os.environ['SOURCE_SHA256']; n=int(os.environ['SOURCE_BYTES']); tmp=pathlib.Path(os.environ.get('RUNNER_TEMP','/tmp')); local=tmp/fname
          def comment(msg):
            q=urllib.request.Request(f'https://api.github.com/repos/{repo}/issues/35/comments',data=json.dumps({'body':msg}).encode(),method='POST',headers={'Authorization':'Bearer '+gh,'Content-Type':'application/json','Accept':'application/vnd.github+json'}); urllib.request.urlopen(q,timeout=30).read()
          base=['curl','--fail','--silent','--show-error','--ssl-reqd','--ftp-pasv','--connect-timeout','30','--max-time','600','--user','migration@associacaomilk.pt:'+pwd]
          root='ftp://troi.ptservidor.net:21/'; rdir='drive-canary-2026-08-21'; subprocess.run(base+['--quote','MKD '+rdir,root],check=False,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
          remote=root+rdir+'/'+urllib.parse.quote(fname,safe='._-()'); subprocess.run(base+['-T',str(local),remote],check=True)
          back=tmp/('back-'+fname); subprocess.run(base+[remote,'-o',str(back)],check=True); b=back.read_bytes(); sha=hashlib.sha256(b).hexdigest()
          if len(b)!=n or sha!=expected: raise RuntimeError('remote SHA mismatch')
          comment(f'MISTRAL_REAL_DRIVE_CANARY_TRANSFER_VERIFIED host=troi.ptservidor.net file={fname} bytes={len(b)} sha256={sha} remote={rdir}/{fname} failed=0 drive_writes=0')
          PY
