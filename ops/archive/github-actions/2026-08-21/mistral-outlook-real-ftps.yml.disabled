name: MILK Mistral Outlook -> PTServidor REAL
on:
  push:
    branches: [master]
    paths: ['.github/workflows/mistral-outlook-real-ftps.yml']
permissions:
  contents: read
  issues: write
jobs:
  transfer:
    runs-on: ubuntu-latest
    timeout-minutes: 60
    env:
      MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
      PTSERVIDOR_FTPS_PASSWORD: ${{ secrets.PTSERVIDOR_FTPS_PASSWORD }}
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
      TARGET_SUBJECT: MILK-MISTRAL-REAL-FILE-RELAY-20260821-0216
      TARGET_FILE: ATLAS_VIVO_MILK_CURADORIAS_FISICAS_DIGITAIS_CORPO_INTEGRAL_2026-08-08.docx
    steps:
      - name: Mistral agent opens Outlook relay and transfers attachment by FTPS
        shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import os,json,urllib.request,re,base64,hashlib,pathlib,subprocess,urllib.parse,time
          key=os.environ['MISTRAL_API_KEY']; pwd=os.environ['PTSERVIDOR_FTPS_PASSWORD']; gh=os.environ['GH_TOKEN']; repo=os.environ['REPO']; subj=os.environ['TARGET_SUBJECT']; fname=os.environ['TARGET_FILE'];tmp=pathlib.Path(os.environ.get('RUNNER_TEMP','/tmp'))
          def comment(msg):
            q=urllib.request.Request(f'https://api.github.com/repos/{repo}/issues/35/comments',data=json.dumps({'body':msg}).encode(),method='POST',headers={'Authorization':'Bearer '+gh,'Content-Type':'application/json','Accept':'application/vnd.github+json'})
            urllib.request.urlopen(q,timeout=30).read()
          def get(path):
            q=urllib.request.Request('https://api.mistral.ai'+path,headers={'Authorization':'Bearer '+key,'Accept':'application/json'})
            with urllib.request.urlopen(q,timeout=60) as r:return json.loads(r.read().decode())
          def post(path,payload):
            q=urllib.request.Request('https://api.mistral.ai'+path,data=json.dumps(payload).encode(),method='POST',headers={'Authorization':'Bearer '+key,'Content-Type':'application/json','Accept':'application/json'})
            with urllib.request.urlopen(q,timeout=180) as r:return json.loads(r.read().decode())
          agents=get('/v1/agents/pages'); al=agents.get('data',[]) if isinstance(agents,dict) else agents; agent=None
          for a in al:
            s=(str(a.get('name',''))+' '+str(a.get('description',''))).lower()
            if 'migra' in s and ('preserv' in s or 'transfer' in s):agent=a;break
          comment('MISTRAL_OUTLOOK_REAL_TRANSFER_STARTED subject='+subj+' agent='+(str(agent.get('name')) if agent else 'runtime')+' drive_writes=0')
          prompt=f'Use ONLY the Outlook connector in read-only mode. Search for the exact subject "{subj}", open that email and inspect its attachment named "{fname}". Do not quote document contents and do not modify mail. Return ATTACHMENT_FOUND if present and make the attachment/resource available in the tool result.'
          payload={'inputs':[{'role':'user','content':prompt}],'tools':[{'type':'connector','connector_id':'outlook'}]}
          if agent:payload['agent_id']=agent['id']
          else:payload['model']='mistral-small-latest'
          conv=post('/v1/conversations',payload)
          out=conv.get('outputs',[]); types=[str(x.get('type') or 'dict') for x in out if isinstance(x,dict)]
          text=' '.join(str(x.get('content','')) for x in out if isinstance(x,dict) and x.get('type') in ('message.output','message'))
          comment('MISTRAL_OUTLOOK_ATTACHMENT_AGENT_RESULT output_types='+','.join(types[:50])+' found='+('yes' if 'ATTACHMENT_FOUND' in text else 'agent_unsure')+' drive_writes=0')
          urls=[];blobs=[];names=[]
          def rec(v):
            if isinstance(v,dict):
              if v.get('name'):names.append(str(v.get('name')))
              for k,z in v.items():
                kl=str(k).lower()
                if isinstance(z,str) and kl in ('uri','url','download_url','href') and z.startswith(('https://','http://')):urls.append(z)
                if isinstance(z,str) and kl in ('blob','base64','data','contentbytes') and len(z)>1000:blobs.append(z)
                rec(z)
            elif isinstance(v,list):
              for z in v:rec(z)
            elif isinstance(v,str):
              for u in re.findall(r'https://[^\s"<>]+',v):urls.append(u.rstrip(').,]'))
              s=v.strip()
              if s.startswith(('{','[')):
                try:rec(json.loads(s))
                except:pass
          rec(out)
          local=tmp/fname; mode=None
          for b in blobs:
            try:
              raw=base64.b64decode(b,validate=False)
              if raw[:2]==b'PK' and len(raw)>10000:local.write_bytes(raw);mode='embedded_resource';break
            except:pass
          if not mode:
            for u in urls:
              print('::add-mask::'+u)
              try:
                q=urllib.request.Request(u,headers={'User-Agent':'MILK-Mistral-Migration/1.0'})
                with urllib.request.urlopen(q,timeout=300) as r:raw=r.read()
                if raw[:2]==b'PK' and len(raw)>10000:local.write_bytes(raw);mode='resource_link';break
              except:continue
          if not mode:
            # inspect exact Outlook tool schemas so a direct open call can be used on the next attempt, without leaking mail content
            tools=get('/v1/connectors/outlook/tools?page_size=100')
            tl=tools if isinstance(tools,list) else (tools.get('items') or tools.get('data') or tools.get('tools') or [])
            schemas=[]
            for t in tl:
              if isinstance(t,dict) and t.get('name') in ('search_outlook','open_outlook_email'):
                s=t.get('inputSchema') or t.get('input_schema') or {};schemas.append({'name':t.get('name'),'required':s.get('required'),'properties':list((s.get('properties') or {}).keys())})
            comment('MISTRAL_OUTLOOK_ATTACHMENT_BINARY_BLOCKED resource_urls='+str(len(urls))+' blobs='+str(len(blobs))+' schemas='+json.dumps(schemas,separators=(',',':'))+' drive_writes=0')
            raise SystemExit(30)
          data=local.read_bytes();sha=hashlib.sha256(data).hexdigest();size=len(data);comment(f'MISTRAL_OUTLOOK_BINARY_ACQUIRED file={fname} bytes={size} sha256={sha} mode={mode}')
          base=['curl','--fail','--silent','--show-error','--ssl-reqd','--ftp-pasv','--connect-timeout','30','--max-time','1800','--user','migration@associacaomilk.pt:'+pwd]
          rdir='drive-current-relay-2026-08-21';subprocess.run(base+['--quote','MKD '+rdir,'ftp://troi.ptservidor.net:21/'],check=False)
          remote=urllib.parse.quote(fname,safe='._-() ');url='ftp://troi.ptservidor.net:21/'+rdir+'/'+remote
          subprocess.run(base+['-T',str(local),url],check=True);back=tmp/('back-'+fname);subprocess.run(base+[url,'-o',str(back)],check=True)
          bsha=hashlib.sha256(back.read_bytes()).hexdigest();bsize=back.stat().st_size
          if bsha!=sha or bsize!=size:raise RuntimeError('FTPS download-back verification mismatch')
          comment(f'MISTRAL_REAL_DRIVE_FILE_TRANSFER_VERIFIED file={fname} bytes={size} sha256={sha} remote={rdir}/{fname} source=Google_Drive_readonly_via_private_Outlook_relay drive_writes=0')
          PY
