@prefix milk: <https://associacaomilk.pt/ontology/milk#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.

<https://associacaomilk.pt/ontology/milk> a owl:Ontology ;
    rdfs:label "MILK Ontology" ;
    owl:versionInfo "1.0.0" .

milk:Source a owl:Class ; rdfs:label "Source" .
milk:Chunk a owl:Class ; rdfs:label "Chunk" .
milk:Answer a owl:Class ; rdfs:label "Answer" .

milk:sourceId a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:sha256 a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:chunkId a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:text a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:visibility a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:epistemicState a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:responsibleEntity a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:municipality a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:parish a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:documentType a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:rgpdStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:consentStatus a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:humanValidated a owl:DatatypeProperty ; rdfs:range xsd:boolean .
milk:aiRiskLevel a owl:DatatypeProperty ; rdfs:range xsd:string .
milk:hasCitation a owl:ObjectProperty ; rdfs:range milk:Chunk .
