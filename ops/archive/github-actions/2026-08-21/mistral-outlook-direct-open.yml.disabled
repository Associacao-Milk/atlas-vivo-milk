name: MILK Mistral Outlook Direct Open
on:
  push:
    branches: [master]
    paths: ['.github/workflows/mistral-outlook-direct-open.yml']
permissions:
  contents: read
  issues: write
jobs:
  inspect:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    env:
      MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
    steps:
      - shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import os,json,urllib.request,re
          key=os.environ['MISTRAL_API_KEY'];gh=os.environ['GH_TOKEN'];repo=os.environ['REPO'];subject='MILK-MISTRAL-REAL-FILE-RELAY-20260821-0216';mailbox='piuprojetoitinerante@gmail.com'
          def comment(msg):
            q=urllib.request.Request(f'https://api.github.com/repos/{repo}/issues/35/comments',data=json.dumps({'body':msg}).encode(),method='POST',headers={'Authorization':'Bearer '+gh,'Content-Type':'application/json'})
            urllib.request.urlopen(q,timeout=30).read()
          def call(tool,args):
            u='https://api.mistral.ai/v1/connectors/outlook/tools/'+tool+'/call'
            q=urllib.request.Request(u,data=json.dumps({'arguments':args}).encode(),method='POST',headers={'Authorization':'Bearer '+key,'Content-Type':'application/json','Accept':'application/json'})
            with urllib.request.urlopen(q,timeout=120) as r:return json.loads(r.read().decode())
          def decoded_text(resp):
            out=[]
            def rec(v):
              if isinstance(v,dict):
                if isinstance(v.get('text'),str):out.append(v['text'])
                for z in v.values():rec(z)
              elif isinstance(v,list):
                for z in v:rec(z)
            rec(resp);return '\n'.join(out)
          sr=call('search_outlook',{'query':subject,'mailbox':mailbox,'has_attachments':True,'limit':20})
          txt=decoded_text(sr)
          mid=None
          # Parse JSON encoded in text first.
          candidates=[]
          for s in [txt]:
            for m in re.finditer(r'\{.*?\}',s,re.S):
              try:candidates.append(json.loads(m.group(0)))
              except:pass
          def walk(v):
            nonlocal_mid=[None]
          objs=[]
          def rec(v):
            if isinstance(v,dict):
              objs.append(v)
              for z in v.values():rec(z)
            elif isinstance(v,list):
              for z in v:rec(z)
            elif isinstance(v,str) and v.strip().startswith(('{','[')):
              try:rec(json.loads(v))
              except:pass
          rec(sr)
          for d in objs:
            subj=str(d.get('subject') or d.get('title') or '')
            if subject in subj or (not subj and d.get('message_id')):
              for k in ('message_id','id','messageId'):
                if d.get(k):mid=str(d[k]);break
            if mid:break
          if not mid:
            pats=[r'"message_id"\s*:\s*"([^"]+)"',r'"id"\s*:\s*"([A-Za-z0-9_=-]{10,})"']
            for p in pats:
              m=re.search(p,txt)
              if m:mid=m.group(1);break
          comment('MISTRAL_OUTLOOK_DIRECT_SEARCH found_message_id='+('yes' if mid else 'no')+' result_content_types='+','.join(str(x.get('type')) for x in sr.get('content',[]) if isinstance(x,dict)))
          if not mid:raise SystemExit(20)
          op=call('open_outlook_email',{'message_id':mid,'mailbox':mailbox})
          # Never emit body or attachment bytes. Emit only structural keys/types and attachment metadata.
          keys=set(); atts=[]; schemes=set(); resources=[]
          def scan(v,path=''):
            if isinstance(v,dict):
              for k,z in v.items():
                keys.add(str(k))
                kl=str(k).lower(); np=(path+'.'+str(k)).strip('.')
                if kl in ('attachments','attachment','fileattachments'):
                  if isinstance(z,list):
                    for a in z:
                      if isinstance(a,dict):atts.append({kk:a.get(kk) for kk in ('id','name','contentType','size','isInline','contentBytes','downloadUrl','url') if kk in a and kk!='contentBytes'} | ({'has_contentBytes':bool(a.get('contentBytes'))} if 'contentBytes' in a else {}))
                if isinstance(z,str):
                  for sm in re.findall(r'\b([A-Za-z][A-Za-z0-9+.-]+)://',z):schemes.add(sm)
                  if kl in ('uri','url','download_url','downloadurl','href'):resources.append({'path':np,'scheme':z.split(':',1)[0],'length':len(z)})
                scan(z,np)
            elif isinstance(v,list):
              for i,z in enumerate(v):scan(z,path+'[]')
            elif isinstance(v,str) and v.strip().startswith(('{','[')):
              try:scan(json.loads(v),path+'.decoded')
              except:pass
          scan(op)
          comment('MISTRAL_OUTLOOK_DIRECT_OPEN keys='+','.join(sorted(keys))[:1600]+' attachments='+json.dumps(atts,separators=(',',':'))[:1200]+' resource_refs='+json.dumps(resources,separators=(',',':'))[:800]+' schemes='+','.join(sorted(schemes))+' raw_content_types='+','.join(str(x.get('type')) for x in op.get('content',[]) if isinstance(x,dict)))
          PY
