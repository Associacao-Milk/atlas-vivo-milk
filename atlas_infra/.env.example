# === Atlas Vivo MILK — variáveis de ambiente ===
# Copiar para .env e preencher. Nunca commitar .env com segredos reais.

# Domínio PT do servidor (ex.: atlas.milk.pt)
ATLAS_DOMAIN=atlas.milk.pt

# PostgreSQL + pgvector
POSTGRES_USER=milk
POSTGRES_DB=atlas_vivo
POSTGRES_PASSWORD=trocar-esta-palavra-passe-forte
POSTGRES_HOST=db
POSTGRES_PORT=5432

# API
NODE_ENV=production
PORT=3000
API_UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=500

# Segurança — JWT RS256 (gerar com: openssl genrsa -out jwt-private.pem 2048)
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem
JWT_ISSUER=atlas.milk.pt
JWT_EXPIRES_DAYS=3650

# HuggingFace (NLP PT: bertimbau, xlm-roberta)
HF_TOKEN=

# Connectors — chaves API quando exigidas pela fonte (maioria: none)
DGAL_API_KEY=
INE_API_KEY=
MATRIZNET_API_KEY=

# CORS — origens permitidas (separadas por vírgula)
CORS_ORIGINS=https://atlas.milk.pt,https://www.atlas.milk.pt

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
