name: MILK Drive -> PTServidor FTPS Migration

on:
  workflow_dispatch:
  push:
    branches: [master]
    paths:
      - '.github/workflows/migrate-drive-nextcloud.yml'

permissions:
  contents: read

concurrency:
  group: milk-drive-ptservidor-migration
  cancel-in-progress: false

env:
  FTPS_HOST: associacaomilk.pt
  FTPS_PORT: '21'
  FTPS_USER: migration@associacaomilk.pt
  FTPS_PASSWORD: ${{ secrets.PTSERVIDOR_FTPS_PASSWORD }}
  GOOGLE_SERVICE_ACCOUNT_JSON: ${{ secrets.GOOGLE_SERVICE_ACCOUNT_JSON || secrets.GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON || secrets.GDRIVE_SERVICE_ACCOUNT_JSON }}
  GOOGLE_CLIENT_ID: ${{ secrets.GOOGLE_CLIENT_ID || secrets.GDRIVE_CLIENT_ID }}
  GOOGLE_CLIENT_SECRET: ${{ secrets.GOOGLE_CLIENT_SECRET || secrets.GDRIVE_CLIENT_SECRET }}
  GOOGLE_REFRESH_TOKEN: ${{ secrets.GOOGLE_REFRESH_TOKEN || secrets.GDRIVE_REFRESH_TOKEN }}
  RCLONE_CONFIG_SECRET: ${{ secrets.RCLONE_CONFIG }}

jobs:
  migrate:
    runs-on: ubuntu-latest
    timeout-minutes: 360
    steps:
      - name: Validate opaque FTPS secret
        shell: bash
        run: |
          set -euo pipefail
          test -n "$FTPS_PASSWORD" || { echo '::error::PTSERVIDOR_FTPS_PASSWORD missing'; exit 2; }
          echo 'FTPS_SECRET_PRESENT'

      - name: FTPS TLS canary upload download-back SHA256
        shell: bash
        run: |
          set -euo pipefail
          canary=".milk-canary-${GITHUB_RUN_ID}.bin"
          head -c 4096 /dev/urandom > "$RUNNER_TEMP/canary.bin"
          local_sha="$(sha256sum "$RUNNER_TEMP/canary.bin" | awk '{print $1}')"
          url="ftp://${FTPS_HOST}:${FTPS_PORT}/${canary}"
          curl --fail --silent --show-error --ssl-reqd --ftp-pasv --user "$FTPS_USER:$FTPS_PASSWORD" -T "$RUNNER_TEMP/canary.bin" "$url"
          curl --fail --silent --show-error --ssl-reqd --ftp-pasv --user "$FTPS_USER:$FTPS_PASSWORD" "$url" -o "$RUNNER_TEMP/canary.back.bin"
          back_sha="$(sha256sum "$RUNNER_TEMP/canary.back.bin" | awk '{print $1}')"
          test "$local_sha" = "$back_sha"
          curl --fail --silent --show-error --ssl-reqd --ftp-pasv --user "$FTPS_USER:$FTPS_PASSWORD" -Q "DELE /${canary}" "ftp://${FTPS_HOST}:${FTPS_PORT}/" >/dev/null
          printf '{"state":"FTPS_CANARY_VERIFIED","bytes":4096,"sha256":"%s","drive_writes":0}\n' "$local_sha" > "$RUNNER_TEMP/ftps-canary-receipt.json"
          echo 'FTPS_CANARY_VERIFIED'

      - name: Install rclone
        shell: bash
        run: |
          set -euo pipefail
          curl -fsSL https://rclone.org/install.sh | sudo bash
          rclone version

      - name: Configure Google Drive read-only source
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$HOME/.config/rclone"
          if [ -n "$RCLONE_CONFIG_SECRET" ]; then
            printf '%s' "$RCLONE_CONFIG_SECRET" > "$HOME/.config/rclone/rclone.conf"
          elif [ -n "$GOOGLE_SERVICE_ACCOUNT_JSON" ]; then
            printf '%s' "$GOOGLE_SERVICE_ACCOUNT_JSON" > "$RUNNER_TEMP/gdrive-sa.json"
            chmod 600 "$RUNNER_TEMP/gdrive-sa.json"
            rclone config create gdrive drive service_account_file "$RUNNER_TEMP/gdrive-sa.json" scope drive.readonly --non-interactive
          elif [ -n "$GOOGLE_CLIENT_ID" ] && [ -n "$GOOGLE_CLIENT_SECRET" ] && [ -n "$GOOGLE_REFRESH_TOKEN" ]; then
            python - <<'PY'
          import json, os, pathlib
          cfg=pathlib.Path.home()/'.config/rclone/rclone.conf'
          tok=json.dumps({'access_token':'','token_type':'Bearer','refresh_token':os.environ['GOOGLE_REFRESH_TOKEN'],'expiry':'2000-01-01T00:00:00Z'})
          cfg.write_text('[gdrive]\ntype = drive\nclient_id = '+os.environ['GOOGLE_CLIENT_ID']+'\nclient_secret = '+os.environ['GOOGLE_CLIENT_SECRET']+'\nscope = drive.readonly\ntoken = '+tok+'\n', encoding='utf-8')
          PY
          else
            echo '::error::No usable Google Drive credential secret found'; exit 10
          fi
          remote="$(rclone listremotes | grep -E '^(gdrive|drive|google-drive|google):$' | head -n1 || true)"
          test -n "$remote" || { echo '::error::No Google Drive rclone remote found'; exit 11; }
          echo "SOURCE_REMOTE=$remote" >> "$GITHUB_ENV"
          rclone lsd "$remote" --max-depth 1 >/dev/null
          echo 'GDRIVE_READONLY_AUTH_OK'

      - name: Configure PTServidor FTPS destination
        shell: bash
        run: |
          set -euo pipefail
          obscured="$(rclone obscure "$FTPS_PASSWORD")"
          rclone config create ptftps ftp host "$FTPS_HOST" port "$FTPS_PORT" user "$FTPS_USER" pass "$obscured" explicit_tls true --non-interactive
          rclone lsd ptftps: >/dev/null
          echo 'PTSERVIDOR_FTPS_AUTH_OK'

      - name: Preservative full Drive migration
        shell: bash
        run: |
          set -euo pipefail
          rclone copy "$SOURCE_REMOTE" ptftps: \
            --fast-list --transfers 8 --checkers 16 --retries 5 --low-level-retries 20 \
            --create-empty-src-dirs --log-file "$RUNNER_TEMP/rclone-migration.log" --log-level INFO
          echo 'TRANSFER_COMPLETE_PENDING_VERIFICATION'

      - name: Verify destination by download comparison
        shell: bash
        run: |
          set -euo pipefail
          rclone check "$SOURCE_REMOTE" ptftps: --one-way --download --checkers 8 --retries 3 \
            --log-file "$RUNNER_TEMP/rclone-check.log" --log-level INFO
          echo 'FULL_TRANSFER_FIXITY_OK'

      - name: Produce migration receipt
        shell: bash
        run: |
          set -euo pipefail
          export SOURCE_JSON="$(rclone size "$SOURCE_REMOTE" --json)"
          export DEST_JSON="$(rclone size ptftps: --json)"
          python - <<'PY'
          import json, os, time
          src=json.loads(os.environ['SOURCE_JSON']); dst=json.loads(os.environ['DEST_JSON'])
          receipt={
            'state':'MIGRATION_VERIFIED',
            'verified_at':time.strftime('%Y-%m-%dT%H:%M:%SZ',time.gmtime()),
            'source':'Google Drive read-only',
            'destination':'PTServidor FTPS private migration account',
            'source_objects':src.get('count'), 'source_bytes':src.get('bytes'),
            'destination_objects':dst.get('count'), 'destination_bytes':dst.get('bytes'),
            'failed':0, 'drive_writes':0, 'verification':'rclone check --download'
          }
          open(os.environ['RUNNER_TEMP']+'/migration-receipt.json','w').write(json.dumps(receipt,indent=2,sort_keys=True))
          print(json.dumps(receipt,sort_keys=True))
          PY

      - name: Preserve receipts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: milk-drive-ptservidor-migration-receipts
          path: |
            ${{ runner.temp }}/ftps-canary-receipt.json
            ${{ runner.temp }}/migration-receipt.json
            ${{ runner.temp }}/rclone-migration.log
            ${{ runner.temp }}/rclone-check.log
          if-no-files-found: ignore
          retention-days: 30

# forced-execution: 2026-08-20T19:59+01:00
