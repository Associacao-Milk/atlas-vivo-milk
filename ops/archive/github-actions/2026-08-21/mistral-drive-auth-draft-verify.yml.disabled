name: MILK Mistral Drive OAuth Draft Verify
on:
  push:
    branches: [master]
    paths: ['.github/workflows/mistral-drive-auth-draft-verify.yml']
permissions:
  contents: read
  issues: write
jobs:
  verify:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
    steps:
      - shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import json,os,urllib.request
          key=os.environ["MISTRAL_API_KEY"];gh=os.environ["GH_TOKEN"];repo=os.environ["REPO"]
          def comment(msg):
              q=urllib.request.Request(f"https://api.github.com/repos/{repo}/issues/35/comments",data=json.dumps({"body":msg}).encode(),method="POST",headers={"Authorization":"Bearer "+gh,"Content-Type":"application/json","Accept":"application/vnd.github+json"})
              urllib.request.urlopen(q,timeout=30).read()
          prompt=("Use only Gmail list_drafts. Find an existing draft whose exact subject is "
                  "MILK — Autorizar Google Drive MCP. Do not create, update, send, or delete anything. "
                  "Return only OAUTH_DRAFT_PRESENT if found, otherwise OAUTH_DRAFT_ABSENT.")
          payload={"model":"mistral-small-latest","inputs":[{"role":"user","content":prompt}],
                   "tools":[{"type":"connector","connector_id":"gmail","tool_configuration":{"include":["list_drafts"]}}]}
          q=urllib.request.Request("https://api.mistral.ai/v1/conversations",data=json.dumps(payload).encode(),method="POST",headers={"Authorization":"Bearer "+key,"Content-Type":"application/json","Accept":"application/json"})
          with urllib.request.urlopen(q,timeout=180) as r:conv=json.loads(r.read().decode())
          out=" ".join(str(x.get("content","")) for x in conv.get("outputs",[]) if isinstance(x,dict))
          if "OAUTH_DRAFT_PRESENT" in out:
              comment("MISTRAL_DRIVE_OAUTH_DRAFT_VERIFIED connector=gmail subject=MILK_Autorizar_Google_Drive_MCP url_disclosed=no drive_writes=0")
          else:
              comment("MISTRAL_DRIVE_OAUTH_DRAFT_NOT_VERIFIED connector=gmail url_disclosed=no drive_writes=0")
              raise SystemExit(27)
          PY
