name: MILK Migration ADC

on:
  issues:
    types: [opened]

permissions:
  contents: read
  issues: write

jobs:
  migrate:
    if: ${{ startsWith(github.event.issue.title, '[MILK-MIGRATE-ADC]') }}
    runs-on: ubuntu-latest
    timeout-minutes: 360
    env:
      FTPS_HOST: troi.ptservidor.net
      FTPS_PORT: '21'
      FTPS_USER: migration@associacaomilk.pt
      FTPS_PASSWORD: ${{ secrets.PTSERVIDOR_FTPS_PASSWORD }}
      GOOGLE_DRIVE_ADC_JSON: ${{ secrets.GOOGLE_DRIVE_ADC_JSON }}
      GH_TOKEN: ${{ github.token }}
      ISSUE_NUMBER: ${{ github.event.issue.number }}
      REPO: ${{ github.repository }}
    steps:
      - name: Helper
        shell: bash
        run: |
          cat > "$RUNNER_TEMP/comment.sh" <<'SH'
          #!/usr/bin/env bash
          set -euo pipefail
          msg="$1"
          python - "$msg" > "$RUNNER_TEMP/comment.json" <<'PY'
          import json,sys
          print(json.dumps({'body':sys.argv[1]}))
          PY
          curl -fsS -X POST -H "Authorization: Bearer $GH_TOKEN" -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" "https://api.github.com/repos/$REPO/issues/$ISSUE_NUMBER/comments" -d @"$RUNNER_TEMP/comment.json" >/dev/null
          SH
          chmod +x "$RUNNER_TEMP/comment.sh"
          "$RUNNER_TEMP/comment.sh" "ADC_MIGRATION_EXECUTOR_STARTED run=$GITHUB_RUN_ID"

      - name: Validate secrets
        shell: bash
        run: |
          set -euo pipefail
          test -n "$FTPS_PASSWORD" || { "$RUNNER_TEMP/comment.sh" "BLOCKED: FTPS secret missing"; exit 2; }
          test -n "$GOOGLE_DRIVE_ADC_JSON" || { "$RUNNER_TEMP/comment.sh" "BLOCKED: GOOGLE_DRIVE_ADC_JSON missing"; exit 3; }
          "$RUNNER_TEMP/comment.sh" "REQUIRED_SECRETS_PRESENT"

      - name: Install rclone
        shell: bash
        run: |
          set -euo pipefail
          curl -fsSL https://rclone.org/install.sh | sudo bash >/dev/null

      - name: Configure ephemeral Drive remote from ADC
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p "$HOME/.config/rclone"
          printf '%s' "$GOOGLE_DRIVE_ADC_JSON" > "$RUNNER_TEMP/adc.json"
          chmod 600 "$RUNNER_TEMP/adc.json"
          python - <<'PY'
          import json,os,pathlib
          d=json.load(open(os.environ['RUNNER_TEMP']+'/adc.json'))
          for k in ('client_id','client_secret','refresh_token'):
              if not d.get(k): raise SystemExit('ADC missing '+k)
          tok=json.dumps({'access_token':'','token_type':'Bearer','refresh_token':d['refresh_token'],'expiry':'2000-01-01T00:00:00Z'})
          cfg=pathlib.Path.home()/'.config/rclone/rclone.conf'
          cfg.write_text('[gdrive]\ntype = drive\nclient_id = '+d['client_id']+'\nclient_secret = '+d['client_secret']+'\nscope = drive.readonly\ntoken = '+tok+'\n',encoding='utf-8')
          cfg.chmod(0o600)
          PY
          rclone lsd gdrive: --max-depth 1 >/dev/null
          "$RUNNER_TEMP/comment.sh" "GDRIVE_READONLY_AUTH_OK"

      - name: Verify FTPS canary
        shell: bash
        run: |
          set -euo pipefail
          canary=".milk-adc-canary-${GITHUB_RUN_ID}.bin"
          head -c 4096 /dev/urandom > "$RUNNER_TEMP/canary.bin"
          sha="$(sha256sum "$RUNNER_TEMP/canary.bin"|awk '{print $1}')"
          url="ftp://${FTPS_HOST}:${FTPS_PORT}/${canary}"
          curl --fail --silent --show-error --ssl-reqd --ftp-pasv --user "$FTPS_USER:$FTPS_PASSWORD" -T "$RUNNER_TEMP/canary.bin" "$url"
          curl --fail --silent --show-error --ssl-reqd --ftp-pasv --user "$FTPS_USER:$FTPS_PASSWORD" "$url" -o "$RUNNER_TEMP/canary.back"
          test "$sha" = "$(sha256sum "$RUNNER_TEMP/canary.back"|awk '{print $1}')"
          curl --fail --silent --show-error --ssl-reqd --ftp-pasv --user "$FTPS_USER:$FTPS_PASSWORD" -Q "DELE /${canary}" "ftp://${FTPS_HOST}:${FTPS_PORT}/" >/dev/null
          "$RUNNER_TEMP/comment.sh" "FTPS_CANARY_VERIFIED sha256=$sha bytes=4096"

      - name: Configure FTPS remote
        shell: bash
        run: |
          set -euo pipefail
          rclone config create ptftps ftp host "$FTPS_HOST" port "$FTPS_PORT" user "$FTPS_USER" pass "$(rclone obscure "$FTPS_PASSWORD")" explicit_tls true --non-interactive >/dev/null
          rclone lsd ptftps: >/dev/null
          "$RUNNER_TEMP/comment.sh" "PTSERVIDOR_FTPS_AUTH_OK"

      - name: Execute migration
        shell: bash
        run: |
          set -euo pipefail
          "$RUNNER_TEMP/comment.sh" "BULK_MIGRATION_STARTED"
          rclone copy gdrive: ptftps: --fast-list --transfers 8 --checkers 16 --retries 5 --low-level-retries 20 --create-empty-src-dirs --log-file "$RUNNER_TEMP/rclone-migration.log" --log-level INFO
          "$RUNNER_TEMP/comment.sh" "TRANSFER_COMPLETE_PENDING_VERIFICATION"

      - name: Verify and receipt
        shell: bash
        run: |
          set -euo pipefail
          rclone check gdrive: ptftps: --one-way --download --checkers 8 --retries 3 --log-file "$RUNNER_TEMP/rclone-check.log" --log-level INFO
          src="$(rclone size gdrive: --json)"; dst="$(rclone size ptftps: --json)"
          python - "$src" "$dst" > "$RUNNER_TEMP/receipt.txt" <<'PY'
          import json,sys
          s=json.loads(sys.argv[1]); d=json.loads(sys.argv[2])
          print(f"MIGRATION_VERIFIED source_objects={s.get('count')} source_bytes={s.get('bytes')} destination_objects={d.get('count')} destination_bytes={d.get('bytes')} failed=0 drive_writes=0 verification=rclone_check_download")
          PY
          "$RUNNER_TEMP/comment.sh" "$(cat "$RUNNER_TEMP/receipt.txt")"

      - name: Failure receipt
        if: failure()
        shell: bash
        run: |
          "$RUNNER_TEMP/comment.sh" "ADC_MIGRATION_FAILED run=$GITHUB_RUN_ID drive_writes=0" || true
