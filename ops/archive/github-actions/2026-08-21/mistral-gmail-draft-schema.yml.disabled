name: MILK Mistral Gmail Draft Schema
on:
  push:
    branches: [master]
    paths: ['.github/workflows/mistral-gmail-draft-schema.yml']
permissions:
  contents: read
  issues: write
jobs:
  probe:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      MISTRAL_API_KEY: ${{ secrets.MISTRAL_API_KEY }}
      GH_TOKEN: ${{ github.token }}
      REPO: ${{ github.repository }}
    steps:
      - run: python -m pip install --quiet mistralai==2.9.3
      - shell: bash
        run: |
          set -euo pipefail
          python - <<'PY'
          import json,os,urllib.request
          from mistralai.client import Mistral
          key=os.environ["MISTRAL_API_KEY"];gh=os.environ["GH_TOKEN"];repo=os.environ["REPO"]
          def comment(msg):
              q=urllib.request.Request(f"https://api.github.com/repos/{repo}/issues/35/comments",data=json.dumps({"body":msg}).encode(),method="POST",headers={"Authorization":"Bearer "+gh,"Content-Type":"application/json","Accept":"application/vnd.github+json"})
              urllib.request.urlopen(q,timeout=30).read()
          with Mistral(api_key=key) as client:
              creds=client.beta.connectors.list_user_credentials(connector_id_or_name="gmail")
              ci=getattr(creds,"items",None) or getattr(creds,"data",None) or []
              tools=client.beta.connectors.list_tools(connector_id_or_name="gmail",pretty=True)
              ti=getattr(tools,"items",None) or getattr(tools,"data",None) or tools
              target=None
              for t in ti:
                  if str(getattr(t,"name",""))=="create_draft": target=t;break
              if target is None:
                  comment("MISTRAL_GMAIL_CREATE_DRAFT_SCHEMA_FAILED reason=tool_not_found credential_count="+str(len(ci)))
                  raise SystemExit(28)
              d=target.model_dump() if hasattr(target,"model_dump") else vars(target)
              schema=d.get("input_schema") or d.get("inputSchema") or {}
              props=(schema.get("properties") or {}) if isinstance(schema,dict) else {}
              reqs=(schema.get("required") or []) if isinstance(schema,dict) else []
              summary={k:{"type":(v.get("type") if isinstance(v,dict) else None)} for k,v in props.items()}
              comment("MISTRAL_GMAIL_CREATE_DRAFT_SCHEMA credential_count="+str(len(ci))+" required="+",".join(reqs)+" properties="+json.dumps(summary,separators=(",",":"))[:1200])
          PY
